# Configure these in Netlify's environment settings, not in committed .env files.
RIOT_RSO_CLIENT_ID=
RIOT_RSO_CLIENT_SECRET=
RIOT_RSO_REDIRECT_URI=https://www.valsync.website/.netlify/functions/riot-auth-callback
RIOT_SESSION_SECRET=
# Set only AFTER approved endpoint access has been verified for the web client.
RIOT_PRIVATE_API_ENABLED=false
# Optional; use ONLY the scopes granted to your VALSYNC-owned client.
RIOT_RSO_SCOPE=openid
# Optional Android pairing: independent of RSO; encrypted read-only snapshots.
WEB_PAIRING_ENABLED=false
# Generate at least 32 random characters; functions scope, production context.
WEB_PAIRING_SECRET=
